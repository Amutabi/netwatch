# Application
APP_NAME=NetWatch AI
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite+aiosqlite:///./netwatch.db
# DATABASE_URL=postgresql+asyncpg://netwatch:password@localhost/netwatch

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GNS3
GNS3_HOST=127.0.0.1
GNS3_PORT=3080
GNS3_USER=admin
GNS3_PASSWORD=admin
GNS3_PROJECT_ID=

# Monitoring
POLL_INTERVAL_SECONDS=30
TOPOLOGY_SYNC_INTERVAL_SECONDS=60
DEVICE_STALE_MINUTES=5
PING_TIMEOUT_SECONDS=2
SNMP_COMMUNITY=public

# AI (use OpenAI or Ollama)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Ollama fallback
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# SSH credentials encryption
FERNET_KEY=
